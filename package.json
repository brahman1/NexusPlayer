{
  "name": "nexusplayer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-libvlc-player": "^57.0.54",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "pako": "^3.0.2",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@^0.86.3-0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:mobile": "cross-env EXPO_TV=0 expo start --dev-client",
    "start:tv": "cross-env EXPO_TV=1 expo start --dev-client",
    "prebuild:mobile": "cross-env EXPO_TV=0 expo prebuild --clean",
    "prebuild:tv": "cross-env EXPO_TV=1 expo prebuild --clean",
    "android:mobile": "cross-env EXPO_TV=0 expo run:android",
    "android:tv": "cross-env EXPO_TV=1 expo run:android",
    "ios:mobile": "cross-env EXPO_TV=0 expo run:ios",
    "ios:tv": "cross-env EXPO_TV=1 expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "doctor": "npx expo-doctor"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "private": true
}
