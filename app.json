{
  "expo": {
    "name": "NexusPlayer",
    "slug": "nexusplayer",
    "scheme": "nexusplayer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.brahman1.nexusplayer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.nexusplayer.app",
      "adaptiveIcon": {
        "backgroundColor": "#070A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVRequired": false,
          "androidTVBanner": "./assets/brand/android-tv-banner.png",
          "androidTVIcon": "./assets/brand/android-tv-icon.png",
          "appleTVImages": {
            "icon": "./assets/brand/tvos/icon-1280x768.png",
            "iconSmall": "./assets/brand/tvos/icon-400x240.png",
            "iconSmall2x": "./assets/brand/tvos/icon-800x480.png",
            "topShelf": "./assets/brand/tvos/top-shelf-1920x720.png",
            "topShelf2x": "./assets/brand/tvos/top-shelf-3840x1440.png",
            "topShelfWide": "./assets/brand/tvos/top-shelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/brand/tvos/top-shelf-wide-4640x1440.png"
          },
          "removeFlipperOnAndroid": true,
          "tvosDeploymentTarget": "16.4"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-libvlc-player",
        {
          "localNetworkPermission": "Autoriser NexusPlayer à accéder au réseau local pour lire vos sources.",
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser NexusPlayer à protéger vos identifiants."
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53d53644-f650-485b-a666-9e6272be6804"
      }
    },
    "owner": "brahman2014"
  }
}
